// EvenFlow — Foundational Production Schema
// This is the CORE slice of the full EvenFlow spec:
// Auth, RBAC, multi-tenancy (Platform/Agency), CRM leads, Work Queue, Tasks, Audit.
// Additional modules (Transfers, Vendor API, Calls, Billing, ED, Training) extend this
// same schema in later migrations — see README "Roadmap" section.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_OWNER
  AGENCY_OWNER
  AGENCY_MANAGER
  PRODUCER
  TELEMARKETER
  SUPPORT_ADMIN
  READ_ONLY
}

enum AgencyStatus {
  CREATED
  INVITED
  OPENED
  ACTIVATED
  SETUP_INCOMPLETE
  ACTIVE
  PAUSED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

// A Producer/Telemarketer's live "what are they doing right now" bubble.
// GRINDING/BREAK/LUNCH/AWAY are auto-set by the time clock actions
// (clock-in/break/lunch/clock-out); MEETING/COACHING are only ever set by
// the user themselves, manually, since no clock action implies them.
enum PresenceStatus {
  AWAY
  BREAK
  LUNCH
  MEETING
  GRINDING
  COACHING
}

// Personalize page — a MySpace-style falling-object overlay the user picks
// for their own account. NONE renders nothing.
enum FallingEffect {
  NONE
  HEARTS
  STARS
  SNOW
  MONEY
  BUBBLES
  CONFETTI
  FIRE
}

enum LeadStatus {
  NEW
  CONTACTED
  LEFT_VM
  APPOINTMENT
  QUOTED
  QUOTED_HOT
  FOLLOW_UP
  SOLD
  LOST
  NOT_INTERESTED
  BAD_CONTACT
  DUPLICATE
  DO_NOT_CONTACT
  INELIGIBLE
  ARCHIVED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  SNOOZED
  CANCELLED
}

enum TaskType {
  FOLLOW_UP
  CALLBACK
  APPOINTMENT
  MANAGER
  TRAINING
  WINBACK
  CROSS_SELL
}

enum TelemarketerStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum TransferStatus {
  LEAD_CAPTURED
  QUALIFYING
  QUALIFIED
  NOT_QUALIFIED
  READY
  ROUTING
  NO_ELIGIBLE_DESTINATION
  OFFERED
  ACCEPTED
  REJECTED
  MISSED
  EXPIRED
  CONNECTED
  COMPLETED
  FAILED
  DISPOSITIONED
  CREDIT_REQUESTED
  CREDIT_APPROVED
  CREDIT_DENIED
  CANCELLED
}

enum TransferDisposition {
  CONTACTED
  QUOTE_STARTED
  QUOTED
  SOLD
  FOLLOW_UP
  NOT_INTERESTED
  DUPLICATE
  BAD_CONTACT
  NOT_ELIGIBLE
  DISCONNECTED
  OTHER
}

enum CreditRequestStatus {
  REQUESTED
  APPROVED
  DENIED
  INFO_REQUESTED
}

enum VendorStatus {
  PENDING
  TESTING
  VERIFIED
  LIVE
  PAUSED
  FAILED
}

enum CredentialStatus {
  ACTIVE
  REVOKED
}

// How a vendor's inbound leads get handed to producers.
// ROUND_ROBIN: cycle through every ACTIVE producer in the agency.
// SELECTED_AGENTS: cycle through only Vendor.selectedAgentIds.
// MOSHPIT: leave unassigned — any eligible producer can claim it (see
// leadDistribution.js / GET /leads/moshpit).
// ALPHA_SPLIT: partition every ACTIVE producer's customer last names into
// contiguous A-Z ranges and route by the lead's customer's last name.
// OFFICE_SPLIT: cycle through the agency's Offices, then within the chosen
// office cycle through that office's ACTIVE producers.
enum LeadDistributionMode {
  ROUND_ROBIN
  SELECTED_AGENTS
  MOSHPIT
  ALPHA_SPLIT
  OFFICE_SPLIT
}

// Marketing category a vendor's leads come from — drives the default
// Lead.leadType for anything sourced from that vendor (set once per vendor,
// not per lead). See Agency.priorityRules for how this feeds the producer
// queue's ordering. INTERNET: real-time internet leads sent via the vendor
// API, distinct from a scheduled PAID_AD/META_AD campaign feed.
enum VendorCategory {
  PAID_AD
  DIRECT_MAIL
  META_AD
  INTERNET
  OTHER
}

// Coarse lead-source category the configurable priority engine
// (lib/priority.js) ranks against Agency.priorityRules.typeRank. Derived
// automatically at creation — never picked by hand. INTERNET: vendor-API
// real-time internet leads (Vendor.category INTERNET). REFERRAL: a lead
// referred by an existing customer, set via the bulk-upload category
// picker or a manual disposition, never vendor-derived.
enum LeadType {
  TRANSFER
  REFERRAL
  PAID_AD
  META_AD
  INTERNET
  DIRECT_MAIL
  MANUAL
  WINBACK
  CROSS_SELL
}

enum RevenueCategory {
  SUBSCRIPTION
  TRANSFER_REVENUE
  LEAD_REVENUE
  OTHER
}

enum CostCategory {
  VENDOR_LEAD_COST
  TELEMARKETER_COST
  TRANSFER_COST
  API_COST
  CREDIT
  REFUND
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum CallSource {
  MANUAL_UPLOAD
  BROWSER_EXTENSION
  PHONE_SYSTEM
  API_IMPORT
  WEBHOOK
  OTHER
}

enum CallStatus {
  UPLOADED
  QUEUED
  TRANSCRIBING
  TRANSCRIBED
  ANALYZING
  COMPLETE
  FAILED
}

enum PlanInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model User {
  id                        String         @id @default(uuid())
  email                     String         @unique
  passwordHash              String?
  firstName                 String
  lastName                  String
  phone                     String?
  role                      Role
  status                    UserStatus     @default(INVITED)
  // Live status bubble shown next to the time clock — see PresenceStatus.
  presenceStatus            PresenceStatus @default(AWAY)
  agencyId                  String?
  agency                    Agency?        @relation(fields: [agencyId], references: [id])
  invitedById               String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  deactivatedAt             DateTime?
  // Set each time this user's Ed daily briefing is generated — computes the
  // next briefing's "what changed" deltas against this timestamp, and gates
  // showing it as the opening message to once per day.
  lastBriefingAt            DateTime?
  // Set once the first-login product tour is dismissed (finished or
  // skipped) — null means "show it next time this user logs in."
  tourCompletedAt           DateTime?
  // Per-account cosmetic personalization (Personalize page). The image
  // itself lives in lib/storage.js like a Call recording does — this
  // stores the storage key, never a public URL, and is served back only
  // through an authenticated GET route.
  backgroundImageStorageKey String?
  backgroundImageMimeType   String?
  fallingEffect             FallingEffect  @default(NONE)
  // Which physical office/branch this producer belongs to, for agencies
  // with more than one location — drives OFFICE_SPLIT lead distribution
  // and the roster's office grouping. Optional: an agency with one office
  // (or one that hasn't set any up) just leaves every producer unassigned.
  officeId                  String?
  office                    Office?        @relation(fields: [officeId], references: [id])
  // Month/day used for a birthday celebration popup — the year is stored
  // but ignored everywhere it's read (isBirthdayToday only compares month
  // and day). Never required, never shown to anyone but the account owner
  // and their agency leadership.
  birthday                  DateTime?
  // Set the first time this user's post-signup "welcome" celebration
  // (confetti) has been shown — mirrors tourCompletedAt's exact pattern,
  // just for a one-time celebratory moment instead of the product tour.
  firstLoginCelebratedAt    DateTime?

  invitations               Invitation[]              @relation("InvitationsSent")
  ownInvitation             Invitation?               @relation("InvitationForUser")
  assignedLeads             Lead[]                    @relation("AssignedProducer")
  createdLeads              Lead[]                    @relation("LeadCreatedBy")
  tasksAssigned             Task[]                    @relation("TaskAssignee")
  tasksCreated              Task[]                    @relation("TaskCreatedBy")
  leadNotes                 LeadNote[]
  leadActivities            LeadActivity[]
  leadProductQuotes         LeadProductQuote[]
  auditEvents               AuditEvent[]
  sessions                  Session[]
  telemarketerAssignments   TelemarketerAssignment[]  @relation("TMAssignments")
  transfersCreated          Transfer[]                @relation("TransferCreatedByTM")
  transfersAccepted         Transfer[]                @relation("TransferAcceptedBy")
  callsUploaded             Call[]                    @relation("CallUploadedBy")
  trainingAssignments       TrainingAssignment[]
  conversationParticipants  ConversationParticipant[]
  messagesAuthored          Message[]
  passwordResetTokens       PasswordResetToken[]
  timeClockEntries          TimeClockEntry[]
  announcementsCreated      Announcement[]            @relation("AnnouncementCreatedBy")
  announcementsTargeted     Announcement[]            @relation("AnnouncementTargetUser")
  announcementAcks          AnnouncementAck[]
  producerNotesReceived     ProducerNote[]            @relation("ProducerNoteSubject")
  producerNotesAuthored     ProducerNote[]            @relation("ProducerNoteAuthor")
  leadImportBatchesUploaded LeadImportBatch[]         @relation("LeadImportBatchUploadedBy")
  leadImportBatchesUndone   LeadImportBatch[]         @relation("LeadImportBatchUndoneBy")
  badges                    UserBadge[]               @relation("UserBadges")
  badgesAwarded             UserBadge[]               @relation("UserBadgeAwardedBy")
  ptoRequests               PtoRequest[]              @relation("PtoRequester")
  ptoReviewed               PtoRequest[]              @relation("PtoReviewer")
  breakRoomGameSessions     BreakRoomGameSession[]
  breakRoomHighScores       BreakRoomHighScore[]
  breakRoomAchievements     BreakRoomAchievement[]
  breakRoomJokeHistory      BreakRoomJokeHistory[]

  @@index([agencyId])
  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Invitation {
  id          String    @id @default(uuid())
  email       String
  role        Role
  token       String    @unique
  agencyId    String?
  agency      Agency?   @relation(fields: [agencyId], references: [id])
  invitedById String
  invitedBy   User      @relation("InvitationsSent", fields: [invitedById], references: [id])
  userId      String?   @unique
  user        User?     @relation("InvitationForUser", fields: [userId], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

model Agency {
  id                     String       @id @default(uuid())
  name                   String
  status                 AgencyStatus @default(CREATED)
  timezone               String       @default("America/New_York")
  officeHours            Json?
  products               String[]     @default([])
  // Configurable lead-queue ordering: { typeRank: LeadType[], statusRules:
  // { [LeadStatus]: { afterDays: number, action: 'BUMP_UP' | 'BUMP_DOWN' |
  // 'DROP_OFF' } } }. Null = lib/priority.js's seeded default applies.
  priorityRules          Json?
  crmEnabled             Boolean      @default(true)
  transfersEnabled       Boolean      @default(false)
  coachingEnabled        Boolean      @default(false)
  // Sales Studio (merged Drills + Call Scoring) is gated behind the same
  // coachingEnabled unlock as everything else "Sales Coaching" already
  // covers — this is a SEPARATE compliance-buffer switch, defaulting to
  // enforced. Platform Owner can flip it off per-agency to fully open
  // Sales Studio regardless of unlock status (e.g. a temporary waiver),
  // without touching the real unlock/billing flag.
  salesStudioGateEnabled Boolean      @default(true)
  // Break Room — the employee arcade. On by default (a built-in perk, not
  // an upsell), with the same requireModuleEnabled() gate every other
  // module flag already uses — zero new gating code needed for the
  // on/off switch itself.
  breakRoomEnabled       Boolean      @default(true)
  // { games: {CONGO_LINE,BUCKETS,FULL_SEND,PILL_POP: bool}, pickMeUpEnabled,
  // lunchEligible, soundsEnabled, achievementsEnabled,
  // leaderboardScope: {office, agency} } — null = lib/breakRoom.js's
  // seeded default applies, same null-fallback precedent as priorityRules.
  breakRoomSettings      Json?
  transferPaused         Boolean      @default(false)
  transferDailyCap       Int?
  transferStates         String[]     @default([])
  // Fee EvenFlow/Yield charges this agency per accepted transfer, in integer cents.
  // Null = not configured; no revenue event is fabricated if unset.
  transferFeeCents       Int?
  // The one Stripe Customer object for this agency's self-serve seat
  // subscription (routes/billing.js's self-serve section). Null until the
  // agency's owner starts a checkout — never fabricated.
  stripeCustomerId       String?

  // ======================================================================
  // RECORD STORE — Boberdoo/LeadPortal wholesale lead marketplace
  // ======================================================================
  // Company-level contact info Boberdoo's createNewPartner requires
  // (Address/City/State/Zip) — collected once, during Record Store setup
  // if missing, and reused for every subsequent Record Store action. Never
  // required for agencies that never touch Record Store.
  address                       String?
  city                          String?
  state                         String?
  zip                           String?
  // One Boberdoo Partner per EvenFlow Agency (never one per product/order —
  // see lib/recordStoreProvisioning.js's idempotent provisionPartner()).
  // Null until the agency's first Record Store order provisions one, or a
  // Platform Owner links an existing Boberdoo account via the admin
  // "LINK EXISTING BOBERDOO PARTNER" flow.
  boberdooPartnerId             String?
  // Local mirror of Boberdoo's own Partner status (0 Not Active / 1
  // Temporarily Stopped / 2 Active) — EvenFlow is authoritative for DESIRED
  // state (what the owner wants), Boberdoo is authoritative for EFFECTIVE
  // state; this field tracks the last status we told Boberdoo to set, not
  // a guess, and is only ever written right after a confirmed Boberdoo call.
  boberdooPartnerStatus         Int?
  boberdooSyncStatus            BoberdooSyncStatus @default(SYNCED)
  boberdooSyncError             String?
  boberdooLastSyncAt            DateTime?
  // Set once Boberdoo's own getPartnerCreditandBalance confirms the
  // initial deposit has landed — never set merely because the owner was
  // redirected to the payment page (see lib/recordStoreProvisioning.js's
  // refreshFundingStatus()).
  recordStoreDepositConfirmedAt DateTime?
  // Cached balance snapshot — Boberdoo remains the authoritative source;
  // this is just what the UI shows between refreshes.
  recordStoreBalanceCents       Int?
  recordStoreBalanceCheckedAt   DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  users                    User[]
  leads                    Lead[]
  tasks                    Task[]
  invitations              Invitation[]
  auditEvents              AuditEvent[]
  goals                    Goal[]
  telemarketerAssignments  TelemarketerAssignment[]
  transfers                Transfer[]
  vendors                  Vendor[]
  revenueEvents            RevenueEvent[]
  costEvents               CostEvent[]
  calls                    Call[]
  subscriptions            AgencySubscription[]
  opportunities            Opportunity[]
  conversations            Conversation[]
  timeClockEntries         TimeClockEntry[]
  announcements            Announcement[]
  producerNotes            ProducerNote[]
  offices                  Office[]
  recordStoreSubscriptions RecordStoreSubscription[]
  leadImportBatches        LeadImportBatch[]
  userBadges               UserBadge[]
  ptoRequests              PtoRequest[]
  breakRoomGameSessions    BreakRoomGameSession[]
  breakRoomHighScores      BreakRoomHighScore[]
  breakRoomAchievements    BreakRoomAchievement[]
}

enum BoberdooSyncStatus {
  SYNCED
  PENDING
  ERROR
}

// A physical branch/location within an agency — lets an agency with more
// than one office assign producers to the right one and split vendor lead
// flow across offices (LeadDistributionMode.OFFICE_SPLIT). Purely optional:
// an agency that never creates one just has every producer unassigned.
model Office {
  id        String   @id @default(uuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id])
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@index([agencyId])
}

// Roster Settings — recognition badges. Most types are manually awarded by
// Agency Owner/Manager (licenses, service anniversaries); AGENT_OF_THE_MONTH
// is additionally auto-computed once a month (lib/agentOfMonth.js) from
// real SOLD-lead counts, never fabricated/guessed.
enum BadgeType {
  FIRST_YEAR
  FIVE_YEAR
  TEN_YEAR
  PC_LICENSE
  LIFE_LICENSE
  AGENT_OF_THE_MONTH
}

model UserBadge {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("UserBadges", fields: [userId], references: [id])
  agencyId    String
  agency      Agency    @relation(fields: [agencyId], references: [id])
  type        BadgeType
  // For AGENT_OF_THE_MONTH only — e.g. "2026-10", used to make the
  // monthly auto-compute idempotent (never award the same month twice).
  periodLabel String?
  awardedAt   DateTime  @default(now())
  awardedById String?
  awardedBy   User?     @relation("UserBadgeAwardedBy", fields: [awardedById], references: [id])

  @@unique([userId, type, periodLabel])
  @@index([userId])
  @@index([agencyId])
}

enum PtoStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

// A producer/TM/manager's own time-off request; Agency Owner/Manager
// approve or deny. Self-cancel is only allowed while still PENDING — once
// reviewed, the decision is leadership's record to keep.
model PtoRequest {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation("PtoRequester", fields: [userId], references: [id])
  agencyId     String
  agency       Agency    @relation(fields: [agencyId], references: [id])
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       PtoStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?     @relation("PtoReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([agencyId])
}

model Customer {
  id              String   @id @default(uuid())
  firstName       String
  lastName        String
  phoneNormalized String?
  email           String?
  address         String?
  city            String?
  state           String?
  zip             String?
  // Products this customer currently holds — populated only from real SOLD
  // dispositions (lead or transfer), never inferred or guessed. This is
  // what the cross-sell detector actually reads.
  products        String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leads         Lead[]
  transfers     Transfer[]
  opportunities Opportunity[]

  @@index([phoneNormalized])
  @@index([email])
}

model Lead {
  id               String           @id @default(uuid())
  agencyId         String
  agency           Agency           @relation(fields: [agencyId], references: [id])
  customerId       String?
  customer         Customer?        @relation(fields: [customerId], references: [id])
  source           String           @default("manual")
  vendorId         String?
  vendor           Vendor?          @relation(fields: [vendorId], references: [id])
  externalLeadId   String?
  rawPayload       Json?
  product          String?
  status           LeadStatus       @default(NEW)
  priorityScore    Int              @default(0)
  priorityReason   String?
  assignedToId     String?
  assignedTo       User?            @relation("AssignedProducer", fields: [assignedToId], references: [id])
  createdById      String?
  createdBy        User?            @relation("LeadCreatedBy", fields: [createdById], references: [id])
  receivedAt       DateTime         @default(now())
  assignedAt       DateTime?
  firstAttemptAt   DateTime?
  firstContactAt   DateTime?
  // Real outbound dials logged via POST /:leadId/activities — a count, not
  // a status change, so it stays accurate no matter how status is set.
  attemptCount     Int              @default(0)
  // Derived automatically at creation (isLiveTransfer -> TRANSFER;
  // vendor-sourced -> the vendor's category; else MANUAL) — drives the
  // configurable priority engine's type-rank component. See
  // Agency.priorityRules and lib/priority.js.
  leadType         LeadType         @default(MANUAL)
  customFields     Json?
  // Set only for a row created by POST /leads/bulk-import — lets the
  // whole batch be found again for the undo action below. Null for every
  // other creation path (manual, vendor API, telemarketer intake).
  importBatchId    String?
  importBatch      LeadImportBatch? @relation(fields: [importBatchId], references: [id])
  // Captured when a producer dispositions this lead as SOLD — real, entered
  // data (not a fabricated commission calculation), which is what makes it
  // legitimate to feed straight into the Financial Ledger as revenue.
  saleProduct      String?
  salePremiumCents Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  archivedAt       DateTime?

  // Set the moment a stale-lead reminder notification is sent (Part 4);
  // read back on the next check so the same lead isn't re-notified until
  // the staleness window has passed again.
  lastReminderSentAt DateTime?

  // Set the moment a "speed to first attempt" SLA-breach alert fires (see
  // lib/firstAttemptSlaAlerts.js) — a separate, much faster real-time check
  // than the general staleness reminder above, so it needs its own
  // re-notify guard rather than sharing lastReminderSentAt.
  firstAttemptSlaAlertSentAt DateTime?

  // A telemarketer flags a lead as a live transfer (the caller is on the
  // line right now) at submission time — makes it claimable through the
  // Moshpit pool the same way a vendor-Moshpit lead is, regardless of the
  // agency's normal distribution mode. Server-set only, never trusted
  // from a non-Telemarketer caller.
  isLiveTransfer Boolean @default(false)

  // True when this lead was explicitly routed to the Moshpit at creation —
  // a bulk CSV/XLS import whose chosen distribution mode resolved to
  // MOSHPIT (by choice, or as a real fallback when no eligible producer
  // existed for the mode actually picked). Vendor-sourced Moshpit leads
  // don't need this (their eligibility already comes from the vendor's
  // own distributionMode at read time); this flag exists because a
  // bulk-imported lead has no vendor relation at all to check.
  moshpitEligible Boolean @default(false)

  // Rich intake fields captured at the moment a Telemarketer submits a
  // lead (source: 'telemarketer') — denormalized onto the Lead itself
  // rather than Customer, since this is an intake-time snapshot (the same
  // reason Transfer already denormalizes contact/state fields locally).
  // All nullable: unused for any other lead source.
  dob               DateTime?
  address           String?
  city              String?
  state             String?
  zip               String?
  vehicleYear       String?
  vehicleMake       String?
  vehicleModel      String?
  additionalDrivers String?
  autoClaims        String?
  violations        String?
  ownRent           String?
  homeAge           String?
  sqFootage         String?
  homeClaims        String?
  currentInsurance  String?
  currentPremium    String?
  yearsWithCarrier  String?
  callbackTime      String?
  tmNotes           String?

  events        LeadEvent[]
  notes         LeadNote[]
  tasks         Task[]
  calls         Call[]
  activities    LeadActivity[]
  productQuotes LeadProductQuote[]

  @@unique([vendorId, externalLeadId])
  @@index([agencyId])
  @@index([assignedToId])
  @@index([status])
  @@index([receivedAt])
  @@index([importBatchId])
}

// One row per bulk spreadsheet upload (POST /leads/bulk-import) — exists
// so that upload can be undone: every Lead it created carries this row's
// id via Lead.importBatchId, and the undo route (POST
// /leads/import-batches/:id/undo) archives whichever of those leads are
// still untouched (no activity/notes/tasks/disposition since import).
// Non-destructive by design — a Lead is never hard-deleted, only
// archived, same mechanism GET /leads's archivedAt filter already uses.
model LeadImportBatch {
  id           String    @id @default(uuid())
  agencyId     String
  agency       Agency    @relation(fields: [agencyId], references: [id])
  uploadedById String
  uploadedBy   User      @relation("LeadImportBatchUploadedBy", fields: [uploadedById], references: [id])
  leadCategory String
  totalRows    Int
  created      Int
  skipped      Int
  createdAt    DateTime  @default(now())
  undoneAt     DateTime?
  undoneById   String?
  undoneBy     User?     @relation("LeadImportBatchUndoneBy", fields: [undoneById], references: [id])

  leads Lead[]

  @@index([agencyId])
}

enum LeadProductStatus {
  QUOTED
  SOLD
}

// Per-product quote/sale tracking on a Lead — independent of the lead's
// overall pipeline `status`. One row per (lead, product): created when a
// product is marked QUOTED, transitions to SOLD with its own premium.
// Diffing this table's products against the canonical product list (see
// lib/products.js) is what tells an agent "what still needs to be
// cross-sold" on this lead. Lead.salePremiumCents/saleProduct stay in sync
// as a derived sum/join of this table's SOLD rows, so existing per-vendor/
// per-zip revenue reports (which read those two fields directly) keep
// working unchanged.
model LeadProductQuote {
  id           String            @id @default(uuid())
  leadId       String
  lead         Lead              @relation(fields: [leadId], references: [id])
  product      String
  status       LeadProductStatus @default(QUOTED)
  premiumCents Int?
  quotedAt     DateTime          @default(now())
  soldAt       DateTime?
  createdById  String?
  createdBy    User?             @relation(fields: [createdById], references: [id])
  updatedAt    DateTime          @updatedAt

  @@unique([leadId, product])
  @@index([leadId])
}

model LeadEvent {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id])
  type       String
  fromStatus String?
  toStatus   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([leadId])
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([leadId])
}

// A logged interaction with a lead — "I called them", "I emailed them",
// "I texted them" — separate from LeadNote (freeform notes) and LeadEvent
// (system-generated status-change audit trail). This is what "activity
// count" on a lead means: real, producer-logged contact attempts.
enum LeadActivityType {
  CALL
  EMAIL
  TEXT
}

enum ActivityDirection {
  OUTBOUND
  INBOUND
}

model LeadActivity {
  id          String            @id @default(uuid())
  leadId      String
  lead        Lead              @relation(fields: [leadId], references: [id])
  type        LeadActivityType
  direction   ActivityDirection @default(OUTBOUND)
  outcome     String?
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  occurredAt  DateTime          @default(now())
  createdAt   DateTime          @default(now())

  @@index([leadId])
}

model Task {
  id           String     @id @default(uuid())
  agencyId     String
  agency       Agency     @relation(fields: [agencyId], references: [id])
  leadId       String?
  lead         Lead?      @relation(fields: [leadId], references: [id])
  type         TaskType
  title        String
  description  String?
  status       TaskStatus @default(OPEN)
  priority     Int        @default(0)
  dueAt        DateTime?
  assignedToId String?
  assignedTo   User?      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById  String?
  createdBy    User?      @relation("TaskCreatedBy", fields: [createdById], references: [id])
  completedAt  DateTime?
  outcome      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([agencyId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueAt])
}

// A single clock-in-to-clock-out shift, with an optional lunch break inside
// it. The "one open entry per user at a time" invariant (can't clock in
// twice, can't start lunch twice, etc.) is enforced in the route layer,
// not here — mirrors this schema's existing preference for a plain event-
// log shape over DB-level state-machine constraints (see LeadEvent).
model TimeClockEntry {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  agencyId     String
  agency       Agency    @relation(fields: [agencyId], references: [id])
  clockInAt    DateTime  @default(now())
  clockOutAt   DateTime?
  lunchStartAt DateTime?
  lunchEndAt   DateTime?
  breakStartAt DateTime?
  breakEndAt   DateTime?
  createdAt    DateTime  @default(now())

  breakRoomGameSessions BreakRoomGameSession[]

  @@index([userId, createdAt])
  @@index([agencyId])
}

// A blast announcement, forced-acknowledgment before the recipient can use
// the app further. Targeting is resolved into a real recipient list at
// creation time (see routes/announcements.js) — this row just records who
// was targeted, in scope-narrowing order: targetUserId (a single specific
// person) overrides everything; else agencyId (that whole agency's real
// team, reusing agencyChat.js's own membership definition); else
// targetRole with a null agencyId (e.g. every Telemarketer platform-wide).
model Announcement {
  id           String   @id @default(uuid())
  createdById  String
  createdBy    User     @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])
  agencyId     String?
  agency       Agency?  @relation(fields: [agencyId], references: [id])
  targetRole   String?
  targetUserId String?
  targetUser   User?    @relation("AnnouncementTargetUser", fields: [targetUserId], references: [id])
  title        String
  body         String
  createdAt    DateTime @default(now())

  acks AnnouncementAck[]

  @@index([agencyId])
  @@index([targetUserId])
}

model AnnouncementAck {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  acknowledgedAt DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

// Freeform coaching notes an Agency Owner/Manager keeps on one producer —
// distinct from LeadNote (a note about a Lead, not a person).
model ProducerNote {
  id         String   @id @default(uuid())
  producerId String
  producer   User     @relation("ProducerNoteSubject", fields: [producerId], references: [id])
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id])
  authorId   String
  author     User     @relation("ProducerNoteAuthor", fields: [authorId], references: [id])
  content    String
  createdAt  DateTime @default(now())

  @@index([producerId, createdAt])
}

model Goal {
  id          String    @id @default(uuid())
  agencyId    String
  agency      Agency    @relation(fields: [agencyId], references: [id])
  userId      String?
  metric      String
  targetValue Int
  periodType  String
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime  @default(now())
  // Set the first time live progress reaches 100% — gates the one-time
  // celebration moment in the UI so it never fires twice for the same goal.
  completedAt DateTime?

  @@index([agencyId])
  @@index([userId])
}

model AuditEvent {
  id            String   @id @default(uuid())
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id])
  actorRole     String?
  agencyId      String?
  agency        Agency?  @relation(fields: [agencyId], references: [id])
  action        String
  entityType    String
  entityId      String?
  before        Json?
  after         Json?
  metadata      Json?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([agencyId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ======================================================================
// YIELD TRANSFERS
// ======================================================================
// Telemarketers are Users with role=TELEMARKETER. This model holds their
// TM-specific profile fields. Assignment to agencies is tracked separately
// (TelemarketerAssignment) so history is never destroyed when reassigned.

model TelemarketerProfile {
  userId    String             @id
  phone     String?
  timezone  String             @default("America/New_York")
  skills    String[]           @default([])
  products  String[]           @default([])
  notes     String?
  status    TelemarketerStatus @default(INVITED)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model TelemarketerAssignment {
  id             String    @id @default(uuid())
  telemarketerId String
  telemarketer   User      @relation("TMAssignments", fields: [telemarketerId], references: [id])
  agencyId       String
  agency         Agency    @relation(fields: [agencyId], references: [id])
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  status         String    @default("ACTIVE") // ACTIVE | ENDED
  assignedById   String?
  notes          String?
  createdAt      DateTime  @default(now())

  @@index([telemarketerId])
  @@index([agencyId])
}

model Transfer {
  id            String    @id @default(uuid())
  agencyId      String?
  agency        Agency?   @relation(fields: [agencyId], references: [id])
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  createdByTMId String
  createdByTM   User      @relation("TransferCreatedByTM", fields: [createdByTMId], references: [id])
  acceptedById  String?
  acceptedBy    User?     @relation("TransferAcceptedBy", fields: [acceptedById], references: [id])

  status           TransferStatus @default(LEAD_CAPTURED)
  product          String
  state            String?
  firstName        String
  lastName         String
  phone            String?
  email            String?
  currentInsurance String?
  notes            String?
  qualification    Json?

  routingReason String?
  offeredAt     DateTime?
  respondedAt   DateTime?
  connectedAt   DateTime?
  completedAt   DateTime?
  rejectReason  String?

  disposition      TransferDisposition?
  dispositionAt    DateTime?
  saleProduct      String?
  salePremiumCents Int?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  events         TransferEvent[]
  creditRequests CreditRequest[]
  revenueEvents  RevenueEvent[]
  costEvents     CostEvent[]

  @@index([agencyId])
  @@index([status])
  @@index([createdByTMId])
}

model TransferEvent {
  id         String   @id @default(uuid())
  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id])
  fromStatus String?
  toStatus   String
  actorId    String?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([transferId])
}

model CreditRequest {
  id            String              @id @default(uuid())
  transferId    String
  transfer      Transfer            @relation(fields: [transferId], references: [id])
  requestedById String
  reason        String
  notes         String?
  status        CreditRequestStatus @default(REQUESTED)
  decidedById   String?
  decidedAt     DateTime?
  decisionNotes String?
  createdAt     DateTime            @default(now())

  @@index([transferId])
}

// ======================================================================
// VENDOR LEAD API
// ======================================================================

model Vendor {
  id               String       @id @default(uuid())
  name             String
  email            String
  agencyId         String
  agency           Agency       @relation(fields: [agencyId], references: [id])
  product          String
  status           VendorStatus @default(PENDING)
  // What this vendor charges per lead, in integer cents. Null = not configured;
  // no cost event is fabricated if unset — the UI will show INSUFFICIENT_DATA instead.
  costPerLeadCents Int?
  createdById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Per-vendor lead distribution control (agency owner configurable).
  // roundRobinCursor advances via an atomic increment on every assignment
  // (ROUND_ROBIN and SELECTED_AGENTS modes) so concurrent inbound leads
  // never double-assign the same "next" agent.
  distributionMode LeadDistributionMode @default(ROUND_ROBIN)
  selectedAgentIds String[]             @default([])
  roundRobinCursor Int                  @default(0)

  // What kind of leads this vendor supplies — every lead sourced from this
  // vendor inherits this as its Lead.leadType (see createLeadRecord).
  category VendorCategory @default(OTHER)

  credentials     VendorCredential[]
  leads           Lead[]
  apiTransactions ApiTransaction[]
  costEvents      CostEvent[]

  @@index([agencyId])
}

model VendorCredential {
  id         String           @id @default(uuid())
  vendorId   String
  vendor     Vendor           @relation(fields: [vendorId], references: [id])
  keyPrefix  String           @unique
  secretHash String
  status     CredentialStatus @default(ACTIVE)
  lastUsedAt DateTime?
  createdAt  DateTime         @default(now())
  revokedAt  DateTime?

  @@index([vendorId])
}

model ApiTransaction {
  id            String   @id @default(uuid())
  vendorId      String?
  vendor        Vendor?  @relation(fields: [vendorId], references: [id])
  method        String
  endpoint      String
  statusCode    Int
  latencyMs     Int
  resultCode    String
  leadId        String?
  errorCode     String?
  correlationId String?
  // Raw payload can contain PII — access to this field must stay restricted;
  // general log views should mask it (see routes/vendors.js maskPayload()).
  rawPayload    Json?
  createdAt     DateTime @default(now())

  @@index([vendorId])
  @@index([createdAt])
}

// ======================================================================
// FINANCIAL LEDGER
// ======================================================================
// All money is stored in integer cents — never floating point.
// Every event is ACTUAL (it was actually entered/derived from a real
// transaction) — nothing here is ever a projection or estimate presented
// as booked revenue. Where a fee/cost isn't configured, no event is
// fabricated; the reporting layer shows INSUFFICIENT_DATA instead.

model RevenueEvent {
  id          String          @id @default(uuid())
  agencyId    String?
  agency      Agency?         @relation(fields: [agencyId], references: [id])
  transferId  String?
  transfer    Transfer?       @relation(fields: [transferId], references: [id])
  category    RevenueCategory
  amountCents Int
  currency    String          @default("USD")
  occurredAt  DateTime        @default(now())
  notes       String?
  createdById String?
  createdAt   DateTime        @default(now())

  @@index([agencyId])
  @@index([occurredAt])
}

model CostEvent {
  id          String       @id @default(uuid())
  agencyId    String?
  agency      Agency?      @relation(fields: [agencyId], references: [id])
  vendorId    String?
  vendor      Vendor?      @relation(fields: [vendorId], references: [id])
  transferId  String?
  transfer    Transfer?    @relation(fields: [transferId], references: [id])
  category    CostCategory
  amountCents Int
  currency    String       @default("USD")
  occurredAt  DateTime     @default(now())
  notes       String?
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([agencyId])
  @@index([vendorId])
  @@index([occurredAt])
}

// ======================================================================
// ED — CENTRAL INTELLIGENCE LAYER
// ======================================================================
// ED's factual context (goals, pace, counts, KPIs, priority) is always
// computed deterministically from real rows — see lib/edContext.js.
// The LLM is only ever used for language/summarization/coaching framing
// on top of that pre-computed, real context — never to invent the numbers
// themselves.

model AiUsageLog {
  id                  String   @id @default(uuid())
  feature             String // e.g. "ed_chat"
  agencyId            String?
  userId              String?
  model               String
  inputTokens         Int
  outputTokens        Int
  // Stored in USD micros (1 micro = 1/1,000,000 of a dollar) rather than
  // cents — a single chat call often costs a fraction of a cent, and cents
  // would round nearly every row down to zero.
  estimatedCostMicros Int
  createdAt           DateTime @default(now())

  @@index([agencyId])
  @@index([createdAt])
}

model EdMessage {
  id        String   @id @default(uuid())
  userId    String
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SupportTicket {
  id          String              @id @default(uuid())
  agencyId    String?
  userId      String
  category    String
  subject     String
  description String
  status      SupportTicketStatus @default(OPEN)
  metadata    Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([agencyId])
  @@index([status])
}

// ======================================================================
// CALL INTELLIGENCE
// ======================================================================
// The analysis pipeline is source-agnostic per spec: a call can arrive via
// manual upload today, and via browser extension / phone system / webhook
// later, without changing anything downstream of "we have an audio file."

model Call {
  id                 String     @id @default(uuid())
  agencyId           String
  agency             Agency     @relation(fields: [agencyId], references: [id])
  uploadedById       String
  uploadedBy         User       @relation("CallUploadedBy", fields: [uploadedById], references: [id])
  leadId             String?
  lead               Lead?      @relation(fields: [leadId], references: [id])
  source             CallSource @default(MANUAL_UPLOAD)
  filename           String
  storageKey         String
  mimeType           String?
  fileSizeBytes      Int?
  durationSeconds    Int?
  status             CallStatus @default(UPLOADED)
  failureReason      String?
  transcript         String?
  transcriptProvider String?
  // The Bunny Stream video GUID for this call's video recording, if the
  // uploader has one (uploaded directly in the Bunny.net dashboard — never
  // re-uploaded or re-hosted by this app). Played via Bunny's own iframe
  // embed in the Coaching tab's per-call detail view. See lib/bunnyStream.js.
  bunnyVideoId       String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  analysis CallAnalysis?

  @@index([agencyId])
  @@index([uploadedById])
  @@index([status])
}

model CallAnalysis {
  id                     String   @id @default(uuid())
  callId                 String   @unique
  call                   Call     @relation(fields: [callId], references: [id])
  summary                String
  productsDiscussed      Json
  objections             Json
  buyingSignals          Json
  missedOpportunities    Json
  crossSellOpportunities Json
  followUpCommitments    Json
  nextSteps              Json
  strengths              Json
  coachingOpportunities  Json
  overallScore           Int
  dimensionScores        Json
  reviewRecommended      Boolean  @default(false)
  reviewReason           String?
  aiModel                String
  managerOverrideScore   Int?
  managerComment         String?
  createdAt              DateTime @default(now())

  @@index([callId])
}

// ======================================================================
// BILLING / ENTITLEMENTS
// ======================================================================
// Per spec: "Do not hardcode pricing assumptions into core logic. If payment
// processor is not configured: billing UI may operate in admin/manual mode.
// Never fake a payment." No payment processor is wired into this build —
// Platform Owner assigns plans/subscriptions manually. The three entitlement
// booleans already on Agency (crmEnabled/transfersEnabled/coachingEnabled)
// are what routes actually check; a Plan just defines the default values a
// subscription applies to those booleans when assigned.

model Plan {
  id               String       @id @default(uuid())
  name             String
  priceCents       Int
  interval         PlanInterval @default(MONTHLY)
  crmEnabled       Boolean      @default(true)
  transfersEnabled Boolean      @default(false)
  coachingEnabled  Boolean      @default(false)
  isActive         Boolean      @default(true)
  // When true, priceCents is a PER-SEAT price (billed by active user count)
  // rather than a flat fee — used by the Agency Owner self-serve Stripe
  // checkout flow, not the Platform-Owner-assigned flat plans.
  perSeat          Boolean      @default(false)
  // The Stripe Price object this plan's self-serve checkout sells. Null
  // until Stripe is configured and the price is created (see lib/stripe.js
  // ensureSeatPriceId) — never fabricated.
  stripePriceId    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  subscriptions AgencySubscription[]
}

model AgencySubscription {
  id                   String             @id @default(uuid())
  agencyId             String
  agency               Agency             @relation(fields: [agencyId], references: [id])
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?
  // Placeholder for a real payment processor's customer/subscription ID.
  // Null in this build since no processor is configured — never fabricated.
  externalCustomerId   String?
  // Set only for a self-serve Stripe subscription (see routes/billing.js's
  // self-serve section) — distinguishes it from a Platform-Owner-assigned
  // flat plan sharing this same table. Null for the latter.
  stripeSubscriptionId String?
  // Snapshot of the seat count Stripe was last told to bill for — kept in
  // sync inline (no job queue in this app) whenever a User's status flips
  // to/from ACTIVE on this agency. See lib/seatBilling.js.
  seatCount            Int?
  assignedById         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([agencyId])
  @@index([status])
}

// ======================================================================
// TRAINING / COACHING CURRICULUM
// ======================================================================
// Distinct from the Call Intelligence coaching loop (per-call scorecards).
// This is structured curriculum: courses -> lessons -> optional quiz,
// assigned to producers, with completion tracked per lesson.

enum TrainingAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

model TrainingCourse {
  id          String   @id @default(uuid())
  title       String
  description String?
  // Loosely matched against a producer's weakest scoring dimension from real
  // call analyses to power the (deterministic, non-fabricated) "recommended
  // for you" surface — see lib/trainingRecommendation.js.
  category    String?
  createdById String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     TrainingLesson[]
  assignments TrainingAssignment[]
}

model TrainingLesson {
  id         String         @id @default(uuid())
  courseId   String
  course     TrainingCourse @relation(fields: [courseId], references: [id])
  title      String
  content    String
  videoUrl   String?
  orderIndex Int            @default(0)
  // Optional quiz: [{ question, options: string[], correctIndex: number }]
  quiz       Json?
  createdAt  DateTime       @default(now())

  completions LessonCompletion[]

  @@index([courseId])
}

model TrainingAssignment {
  id           String                   @id @default(uuid())
  courseId     String
  course       TrainingCourse           @relation(fields: [courseId], references: [id])
  userId       String
  user         User                     @relation(fields: [userId], references: [id])
  assignedById String?
  dueAt        DateTime?
  status       TrainingAssignmentStatus @default(ASSIGNED)
  assignedAt   DateTime                 @default(now())
  completedAt  DateTime?

  lessonCompletions LessonCompletion[]

  @@unique([courseId, userId])
  @@index([userId])
  @@index([courseId])
}

model LessonCompletion {
  id               String             @id @default(uuid())
  assignmentId     String
  assignment       TrainingAssignment @relation(fields: [assignmentId], references: [id])
  lessonId         String
  lesson           TrainingLesson     @relation(fields: [lessonId], references: [id])
  completedAt      DateTime           @default(now())
  quizScorePercent Int?
  quizAnswers      Json?

  @@unique([assignmentId, lessonId])
}

// ======================================================================
// NOTIFICATIONS
// ======================================================================
// Wired only into events that actually fire elsewhere in this codebase —
// no notification type exists here for an event this build can't actually
// produce (e.g. there is no scheduled job for task-overdue or transfer-
// timeout detection yet, so those notification types are deliberately not
// implemented rather than faked with a hook that never fires).

enum NotificationSeverity {
  INFO
  ACTION
  WARNING
  CRITICAL
}

model Notification {
  id                String               @id @default(uuid())
  userId            String
  agencyId          String?
  type              String
  severity          NotificationSeverity @default(INFO)
  title             String
  body              String?
  relatedEntityType String?
  relatedEntityId   String?
  readAt            DateTime?
  createdAt         DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model NotificationPreference {
  userId       String   @id
  emailEnabled Boolean  @default(true)
  // Types the user has muted from generating further notifications.
  // CRITICAL-severity notifications ignore mutes — per spec, critical
  // transfer alerts must not disappear into a generic list.
  mutedTypes   String[] @default([])
  updatedAt    DateTime @updatedAt
}

// ======================================================================
// WINBACK & CROSS-SELL ENGINE
// ======================================================================
// CROSS_SELL opportunities are auto-detected from real data: when a lead or
// transfer is dispositioned SOLD, the customer's product list updates, and
// a gap against a simple complementary-product rule set creates a real
// opportunity — never a fabricated guess.
//
// WINBACK opportunities are honestly NOT auto-detected in this build: there
// is no policy/cancellation lifecycle tracked anywhere in this schema, so
// there is no real signal to detect a lapse from. Winback opportunities are
// created from real, manually-entered data (an agency user records that a
// specific customer's policy lapsed, when, and at what premium) rather than
// inventing an auto-detection rule with no real data behind it.

enum OpportunityType {
  WINBACK
  CROSS_SELL
}

enum OpportunityStatus {
  OPEN
  ASSIGNED
  ATTEMPTED
  CONTACTED
  QUOTED
  WON
  DECLINED
  SNOOZED
  INELIGIBLE
}

model Opportunity {
  id                   String            @id @default(uuid())
  agencyId             String
  agency               Agency            @relation(fields: [agencyId], references: [id])
  customerId           String
  customer             Customer          @relation(fields: [customerId], references: [id])
  type                 OpportunityType
  status               OpportunityStatus @default(OPEN)
  product              String
  // Winback-specific fields — null for CROSS_SELL opportunities.
  previousProduct      String?
  previousPremiumCents Int?
  lostAt               DateTime?
  lostReason           String?
  reason               String
  priorityScore        Int               @default(0)
  assignedToId         String?
  wonPremiumCents      Int?
  snoozeUntil          DateTime?
  createdById          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  events OpportunityEvent[]

  @@index([agencyId])
  @@index([customerId])
  @@index([status])
  @@index([type])
}

model OpportunityEvent {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  fromStatus    String?
  toStatus      String
  actorId       String?
  reason        String?
  createdAt     DateTime    @default(now())

  @@index([opportunityId])
}

// ======================================================================
// OWNER IMPERSONATION
// ======================================================================
// Deliberately NOT modeled with relation fields to User — kept as plain
// scalar IDs and looked up separately, exactly per the lesson learned in
// this project's schema-vs-query audit: fewer relations here means fewer
// ways to introduce the same class of bug.
//
// Security design: the impersonation cookie is opaque (just this log's id).
// The middleware only honors it if the REAL, currently-authenticated
// session's user ID matches this log's platformOwnerId — so the cookie
// value alone can never be forged into impersonating an arbitrary account;
// it only ever re-attaches to whichever platform owner actually started it.
// Sensitive Platform-Owner-only routes stay protected automatically: while
// impersonating, req.user.role becomes the TARGET's role, so any route
// still checking requireRole('PLATFORM_OWNER') correctly denies access —
// exactly the spec's "sensitive operations require exiting impersonation."

model ImpersonationLog {
  id              String    @id @default(uuid())
  platformOwnerId String
  targetUserId    String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?

  @@index([platformOwnerId])
  @@index([targetUserId])
}

// ======================================================================
// FLOW SCORE
// ======================================================================
// Every component is computed from real rows already in this schema
// (leads, tasks, transfers, call analyses) — never fabricated. A component
// with zero underlying data points is excluded entirely (weights of the
// remaining components are renormalized to still sum to 100), not defaulted
// to some invented number. See lib/flowScore.js for the actual calculation.

enum FlowScoreSubjectType {
  USER
  AGENCY
}

enum FlowScoreRole {
  PRODUCER
  TELEMARKETER
  AGENCY
}

model FlowScoreWeightConfig {
  id        String        @id @default(uuid())
  role      FlowScoreRole
  version   Int
  // { componentKey: weight } — weights for an active config always sum to 100.
  weights   Json
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())

  snapshots FlowScoreSnapshot[]

  @@unique([role, version])
  @@index([role, isActive])
}

model FlowScoreSnapshot {
  id                 String                @id @default(uuid())
  subjectType        FlowScoreSubjectType
  subjectId          String
  score              Int
  // [{ key, label, value, weight, contribution, sampleSize, lowConfidence }]
  components         Json
  excludedComponents Json
  weightConfigId     String
  weightConfig       FlowScoreWeightConfig @relation(fields: [weightConfigId], references: [id])
  computedAt         DateTime              @default(now())

  @@index([subjectType, subjectId, computedAt])
}

// ======================================================================
// CHAT
// ======================================================================
// Scoped to a specific real entity: a Lead, a Transfer, or (deliberately,
// as of the Yield Transfers rebuild) an Agency — the one persistent,
// agency-wide team room, with real membership computed live from that
// agency's active users + active TelemarketerAssignments rather than a
// static participant list (see lib/agencyChat.js). No websockets: this
// app has zero real-time infra anywhere else either (same honest
// tradeoff already documented for the call-processing job), so the
// client polls while a thread is open rather than adding new paid
// infrastructure for it.

enum ConversationEntityType {
  LEAD
  TRANSFER
  AGENCY
}

model Conversation {
  id                String                 @id @default(uuid())
  agencyId          String
  agency            Agency                 @relation(fields: [agencyId], references: [id])
  relatedEntityType ConversationEntityType
  relatedEntityId   String
  createdAt         DateTime               @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@unique([relatedEntityType, relatedEntityId])
  @@index([agencyId])
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ======================================================================
// RECORD STORE — Boberdoo/LeadPortal wholesale lead marketplace
// ======================================================================
// An Agency Owner buys a recurring flow of real leads from Yield
// Marketing's lead exchange (a white-labeled Boberdoo instance —
// see docs/lead-portal-api-reference.md and lib/boberdoo.js) directly
// inside EvenFlow, with EvenFlow handling all Partner/Filter-Set
// provisioning behind the scenes. EvenFlow is authoritative for product
// selection, requested daily volume, and desired on/off state; Boberdoo
// is authoritative for the real Partner/Filter Set, actual balance, and
// lead delivery — see lib/recordStoreProvisioning.js's own header comment
// for how the two are reconciled when they disagree.

// A buyable product/template, Super-Admin-configured. Deliberately
// data-driven (slug/displayName/etc.) rather than a fixed Home/Auto/Life
// enum, so a new lead type (HVAC, Solar, aged leads, ...) is just a new
// row, never a code change (see routes/recordStore.js — no
// if/else-by-product-name branching anywhere).
model RecordStoreTemplate {
  id                        String   @id @default(uuid())
  slug                      String   @unique
  displayName               String
  description               String?
  // Free-text, Super-Admin-defined — "HOME" / "AUTO" / future categories.
  // Not an enum on purpose: adding a new category must never need a schema
  // migration (see master spec's "future-proof product architecture").
  productCategory           String
  // Free-text — "INTERNET" / "LIVE_CALL" / future lead-delivery shapes.
  leadType                  String
  // The real Boberdoo TYPE id (Lead_Type) once a Super Admin has looked it
  // up against a live account — getFilterSetsAll/getPartnerSettings is the
  // only reliable source (see docs/lead-portal-api-reference.md §4).
  // Null = this template isn't wired to a real Boberdoo lead type yet.
  boberdooTypeId            String?
  // A human label for whatever Boberdoo-side filter-set blueprint this
  // template maps to (e.g. a saved filter-set name/ID a Super Admin set up
  // once in the Boberdoo portal) — purely descriptive, read by admins only.
  boberdooTemplateReference String?
  filterSetType             String   @default("STANDARD") // "STANDARD" | "IPR"
  isIpr                     Boolean  @default(false)
  // Null = not priced yet; the storefront must never show a fabricated
  // price (see ui — StatTile/product cards read this straight from here).
  wholesalePriceCents       Int?
  minimumDailyVolume        Int      @default(1)
  maximumDailyVolume        Int      @default(200)
  defaultDailyVolume        Int      @default(10)
  minimumDepositCents       Int      @default(150000) // $1,500 — overridable per template
  active                    Boolean  @default(true)
  sortOrder                 Int      @default(0)
  customerVisible           Boolean  @default(true)
  // Boberdoo-specific config that shouldn't clutter the main schema — e.g.
  // the exact insertUpdateFilterSet/iprInsertFilterSet field values this
  // template should submit (Boberdoo's own standard filter-set field list
  // isn't fully documented — see docs/lead-portal-api-reference.md §3 —
  // so these are entered by a Super Admin against a real account rather
  // than guessed at in code), plus IPR defaults (Ring_Timeout,
  // Successful_Minutes, Record_Phone_Call, etc.) the Agency Owner never
  // sees or controls directly.
  configurationJson         Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  subscriptions RecordStoreSubscription[]
}

enum RecordStoreSubscriptionStatus {
  DRAFT
  PENDING_PROVISIONING
  PENDING_FUNDING
  ACTIVE
  PAUSED
  ACCOUNT_PAUSED
  PAYMENT_REQUIRED
  ERROR
  CANCELLED
}

// Fine-grained internal step tracker (distinct from the coarse, customer
// facing `status` above) — what RETRY PROVISIONING actually resumes from,
// and what tells the retry logic whether createPartner/createFilterSet
// need to run again or can be safely skipped (idempotency).
enum RecordStoreProvisioningStatus {
  EVENFLOW_ORDER_CREATED
  BOBERDOO_PARTNER_CREATING
  BOBERDOO_PARTNER_CREATED
  FILTER_SET_CREATING
  FILTER_SET_CREATED
  WAITING_FOR_DEPOSIT
  DEPOSIT_CONFIRMED
  ACTIVATING
  ACTIVE
  PROVISIONING_ERROR
}

enum RecordStoreFundingStatus {
  PENDING
  CONFIRMED
}

// What the Agency Owner WANTS this one product to be doing, independent of
// an account-wide pause — see §19 of the master spec: pausing the whole
// account must never clear an individually-paused product's own desired
// state, so resuming the account only restores products that were
// individually ACTIVE before the account-wide pause.
enum RecordStoreDesiredStatus {
  ACTIVE
  PAUSED
}

model RecordStoreSubscription {
  id                    String              @id @default(uuid())
  agencyId              String
  agency                Agency              @relation(fields: [agencyId], references: [id])
  recordStoreTemplateId String
  template              RecordStoreTemplate @relation(fields: [recordStoreTemplateId], references: [id])

  // Denormalized snapshot of Agency.boberdooPartnerId at provisioning time
  // — the live value always lives on Agency (one Partner per Agency,
  // shared across every subscription); this copy is for audit/history so
  // an old row still shows which Partner it was provisioned under even if
  // something unusual ever changes the agency-level value later.
  boberdooPartnerId   String?
  boberdooFilterSetId String?

  // Snapshots taken at purchase time so a later template rename/re-price
  // never rewrites this order's own history.
  productNameSnapshot String
  leadType            String
  filterSetType       String
  isIpr               Boolean @default(false)
  priceSnapshotCents  Int

  dailyVolume        Int
  // Live Call (IPR) only — the one real, business-level delivery field an
  // Agency Owner sets themselves (master spec §7); every other IPR field
  // (Ring_Timeout, Successful_Minutes, Record_Phone_Call, ...) comes from
  // the template's own configurationJson, never from the customer.
  ringToPhone        String?
  maxConcurrentCalls Int?
  desiredStatus      RecordStoreDesiredStatus      @default(ACTIVE)
  status             RecordStoreSubscriptionStatus @default(DRAFT)
  provisioningStatus RecordStoreProvisioningStatus @default(EVENFLOW_ORDER_CREATED)
  fundingStatus      RecordStoreFundingStatus      @default(PENDING)

  failedStep         String?
  errorCode          String?
  errorMessage       String?
  retryCount         Int       @default(0)
  boberdooSyncError  String?
  lastBoberdooSyncAt DateTime?

  startedAt   DateTime?
  pausedAt    DateTime?
  cancelledAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agencyId])
  @@index([status])
}

// ============================================================
// BREAK ROOM — the employee arcade. Every game session ties back to
// the real TimeClockEntry that was open and ON_BREAK when it started
// (see lib/timeClockState.js's stateOf()) — there is no second, parallel
// "break session" concept invented here. Server-side gating
// (lib/breakRoom.js's canAccessBreakRoom) is the only thing that can
// start or keep a session alive; the client is never trusted alone.
// ============================================================

enum GameType {
  CONGO_LINE
  BUCKETS
  FULL_SEND
  PILL_POP
}

enum BreakRoomSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model BreakRoomGameSession {
  id                      String                 @id @default(uuid())
  userId                  String
  user                    User                   @relation(fields: [userId], references: [id])
  agencyId                String
  agency                  Agency                 @relation(fields: [agencyId], references: [id])
  // Denormalized from User.officeId at session start — a cheap filter
  // for office-scoped leaderboards, never a live join. Same
  // "denormalized snapshot" precedent as RecordStoreSubscription's
  // boberdooPartnerId copy above.
  officeId                String?
  timeClockEntryId        String
  timeClockEntry          TimeClockEntry         @relation(fields: [timeClockEntryId], references: [id])
  gameType                GameType
  status                  BreakRoomSessionStatus @default(ACTIVE)
  startedAt               DateTime               @default(now())
  endedAt                 DateTime?
  durationMs              Int?
  score                   Int                    @default(0)
  // Per-game secondary stats (dancers collected, shots made/attempted,
  // tricks landed, bugs cleared, best streak, ...) — shape varies by
  // gameType, never queried structurally, only stored/displayed.
  metrics                 Json?
  clientToken             String                 @unique
  // Set by lib/breakRoomAntiCheat.js's plausibility check, or by an
  // admin review action — excluded sessions still exist (for audit) but
  // never count toward a high score or leaderboard rank.
  excludedFromLeaderboard Boolean                @default(false)
  flagReason              String?
  // Always true in practice (a session cannot even be created unless
  // canAccessBreakRoom passed) — kept as an explicit, honest field
  // rather than merely assumed, matching the real leaderboard-row shape.
  verifiedBreakSession    Boolean                @default(true)
  createdAt               DateTime               @default(now())

  achievements BreakRoomAchievement[]

  @@index([userId, gameType])
  @@index([agencyId, gameType])
  @@index([gameType, score])
  @@index([timeClockEntryId])
}

// Denormalized personal-best cache per (user, game) — O(1) lookup for
// the Break Room landing page instead of aggregating every session on
// every page load. Recomputed whenever a new session could beat it, and
// whenever an admin excludes/restores a session.
model BreakRoomHighScore {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  officeId    String?
  gameType    GameType
  bestScore   Int      @default(0)
  bestMetrics Json?
  sessionId   String?
  achievedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, gameType])
  @@index([agencyId, gameType, bestScore])
}

// A parallel, new concept from UserBadge/BadgeType (career recognition,
// mostly manually awarded) — this is purely for-fun arcade unlocks, never
// shown to a manager as a performance signal. Same @@unique idempotency-
// key shape as UserBadge, since "has this exact achievement already been
// unlocked" is the same real question.
model BreakRoomAchievement {
  id         String                @id @default(uuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id])
  agencyId   String
  agency     Agency                @relation(fields: [agencyId], references: [id])
  gameType   GameType
  key        String
  sessionId  String?
  session    BreakRoomGameSession? @relation(fields: [sessionId], references: [id])
  unlockedAt DateTime              @default(now())

  @@unique([userId, gameType, key])
  @@index([agencyId])
}

model BreakRoomJoke {
  id        String   @id @default(uuid())
  text      String
  tags      String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  history BreakRoomJokeHistory[]
}

model BreakRoomJokeHistory {
  id      String        @id @default(uuid())
  userId  String
  user    User          @relation(fields: [userId], references: [id])
  jokeId  String
  joke    BreakRoomJoke @relation(fields: [jokeId], references: [id])
  shownAt DateTime      @default(now())

  @@index([userId, shownAt])
}

// The one genuinely platform-wide Break Room switch (a cross-agency
// global leaderboard) — a Super Admin opt-in, singleton row. Everything
// else (per-game enable, lunch eligibility, sounds, achievements,
// office/agency leaderboard scope) lives on Agency.breakRoomSettings,
// mirroring Agency.priorityRules' existing Json-config precedent.
model BreakRoomPlatformSettings {
  id                       String   @id @default("singleton")
  globalLeaderboardEnabled Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}
