    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
