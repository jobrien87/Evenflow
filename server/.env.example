# ===== DATABASE =====
# PostgreSQL connection string. On Render, this comes from your Render Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/evenflow"

# ===== APP =====
# Public URL of the deployed FRONTEND (used to build invitation/accept links, CORS origin).
APP_URL="http://localhost:5173"
# Public URL of THIS server (used in generated vendor posting instructions/curl examples).
SERVER_URL="http://localhost:4000"
NODE_ENV="development"
PORT=4000

# ===== EMAIL (optional but recommended) =====
# Brevo transactional email API (https://www.brevo.com) — a plain HTTPS
# call, no SDK. Get this from Brevo → SMTP & API → API Keys tab (a v3 key,
# starting "xkeysib-" — NOT the SMTP tab's login/password, a different
# credential this app doesn't use). If BREVO_API_KEY is unset,
# invitation/reset emails are NOT sent — the app will clearly report
# emailStatus: "NOT_CONFIGURED" instead of pretending an email went out.
BREVO_API_KEY=""
# Must be a sender verified in Brevo (SPF/DKIM/DMARC on the domain).
EMAIL_FROM="noreply@yield-marketing.com"
EMAIL_FROM_NAME="EvenFlow"

# ===== FUTURE MODULES (not required for this foundational build) =====
# TRANSCRIPTION_PROVIDER_API_KEY=""
# TRANSCRIPTION_PROVIDER_URL=""
# TRANSCRIPTION_PROVIDER_NAME=""
# OBJECT_STORAGE_BUCKET=""
# OBJECT_STORAGE_KEY=""
# OBJECT_STORAGE_SECRET=""
# Local disk is used for call recordings if object storage is not configured.
# This is NOT durable on Render (ephemeral filesystem) — fine for development only.
# LOCAL_UPLOAD_DIR="./uploads"

# ===== ED (AI assistant) =====
# If unset, ED still runs and reports real, deterministic numbers (goals,
# pace, KPIs) — it just won't produce conversational commentary. No fake
# AI output is ever generated in either case.
ANTHROPIC_API_KEY=""
# Required alongside a workspace-scoped API key (one issued under a
# specific Console workspace rather than the org default).
ANTHROPIC_WORKSPACE_ID=""
AI_MODEL="claude-haiku-4-5-20251001"

# ===== BILLING =====
# If STRIPE_SECRET_KEY is unset, the Platform-Owner-assigned flat-plan flow
# still works exactly as before, and the Agency Owner self-serve $35/seat
# checkout (routes/billing.js's self-serve section, lib/stripe.js) honestly
# reports "not configured" rather than faking a subscription.
# A real (test-mode is fine) secret key from the Stripe dashboard. The one
# per-seat Price is created automatically on first use — no need to create
# it by hand first.
# STRIPE_SECRET_KEY=""
# The signing secret for the webhook endpoint (POST /api/billing/webhook),
# from the Stripe dashboard's webhook config for that URL. Required to
# verify that a webhook call genuinely came from Stripe.
# STRIPE_WEBHOOK_SECRET=""
