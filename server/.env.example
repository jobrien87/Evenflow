# ===== DATABASE =====
# PostgreSQL connection string. On Render, this comes from your Render Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/evenflow"

# ===== APP =====
# Public URL of the deployed FRONTEND (used to build invitation/accept links, CORS origin).
APP_URL="http://localhost:5173"
# Public URL of THIS server (used in generated vendor posting instructions/curl examples).
SERVER_URL="http://localhost:4000"
NODE_ENV="development"
PORT=4000

# ===== EMAIL (optional but recommended) =====
# Brevo transactional email API (HTTPS, not SMTP). Raw SMTP egress is not
# viable from Render (confirmed repeatedly in production — every port/
# provider combination tried over SMTP failed with a connection-level
# error), so this app sends over Brevo's HTTPS API instead. Get an API key
# from app.brevo.com (Settings -> SMTP & API -> API Keys). EMAIL_FROM must
# be a sender verified in your Brevo account (a raw @gmail.com address will
# generally be rejected/spam-filtered by Gmail's own DMARC policy when sent
# via a third-party API — use a domain you control). If BREVO_API_KEY is
# unset, invitation/reset emails are NOT sent — the app will clearly report
# emailStatus: "NOT_CONFIGURED" instead of pretending an email went out.
BREVO_API_KEY=""
EMAIL_FROM="noreply@yield-marketing.com"
EMAIL_FROM_NAME="EvenFlow"

# ===== FUTURE MODULES (not required for this foundational build) =====
# TRANSCRIPTION_PROVIDER_API_KEY=""
# TRANSCRIPTION_PROVIDER_URL=""
# TRANSCRIPTION_PROVIDER_NAME=""
# OBJECT_STORAGE_BUCKET=""
# OBJECT_STORAGE_KEY=""
# OBJECT_STORAGE_SECRET=""
# Local disk is used for call recordings if object storage is not configured.
# This is NOT durable on Render (ephemeral filesystem) — fine for development only.
# LOCAL_UPLOAD_DIR="./uploads"

# ===== ED (AI assistant) =====
# If unset, ED still runs and reports real, deterministic numbers (goals,
# pace, KPIs) — it just won't produce conversational commentary. No fake
# AI output is ever generated in either case.
ANTHROPIC_API_KEY=""
# Required alongside a workspace-scoped API key (one issued under a
# specific Console workspace rather than the org default).
ANTHROPIC_WORKSPACE_ID=""
AI_MODEL="claude-haiku-4-5-20251001"

# ===== BILLING =====
# If STRIPE_SECRET_KEY is unset, the Platform-Owner-assigned flat-plan flow
# still works exactly as before, and the Agency Owner self-serve $35/seat
# checkout (routes/billing.js's self-serve section, lib/stripe.js) honestly
# reports "not configured" rather than faking a subscription.
# A real (test-mode is fine) secret key from the Stripe dashboard. The one
# per-seat Price is created automatically on first use — no need to create
# it by hand first.
# STRIPE_SECRET_KEY=""
# The signing secret for the webhook endpoint (POST /api/billing/webhook),
# from the Stripe dashboard's webhook config for that URL. Required to
# verify that a webhook call genuinely came from Stripe.
# STRIPE_WEBHOOK_SECRET=""

# ===== BUNNY.NET STREAM (per-call coaching video) =====
# A manager/producer can attach a Bunny Stream video to an uploaded sales
# call (Coaching tab, Call Coaching for Producers) — played via Bunny's own
# iframe embed, never re-uploaded or re-hosted by this app. The video
# itself is uploaded directly in the Bunny.net dashboard; only its video
# GUID is pasted into Evenflow.
# Library ID from your Bunny Stream library (video.bunnycdn.com).
BUNNY_STREAM_LIBRARY_ID=""
# The library's Stream API key (AccessKey) — used only to validate a
# pasted video GUID actually exists in your library before saving it
# (GET /library/:id/videos/:videoId), never to list/browse/upload. If
# unset, attaching a video honestly reports "not configured" rather than
# saving an unverified id.
BUNNY_STREAM_API_KEY=""

# ===== RECORD STORE (Boberdoo/Yield Marketing Lead Portal) =====
# If BOBERDOO_API_KEY is unset, Record Store's storefront/templates/My Lead
# Programs UI all still work, but creating or changing a real lead program
# honestly reports "Boberdoo is not configured" rather than fabricating a
# Partner ID, Filter Set ID, or balance. See lib/boberdoo.js.
# BOBERDOO_API_KEY=""
# BOBERDOO_API_BASE_URL="https://yieldmarketing.leadportal.com/new_api/api.php"
# The real Boberdoo-hosted payment page URL for the $1,500 initial deposit
# (and later top-ups) — never invented; leave unset until the real page/
# redirect format is supplied, in which case "ADD FUNDS"/"FUND ACCOUNT"
# honestly reports that funding isn't configured yet instead of linking
# somewhere made up.
# BOBERDOO_PAYMENT_PAGE_URL=""
